# Copy this file to .env.local and fill in the values from your Supabase project.
# NEVER commit .env.local — it is gitignored. Set the same values in Vercel.

# Supabase → Project Settings → Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. Supabase → Project Settings → API Keys → service_role.
# This bypasses Row Level Security — keep it secret, server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The single email allowed to sign in to /admin.
ADMIN_EMAIL=maxnelson2@gmail.com

# Where the site is hosted (used for magic-link redirects). For local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
